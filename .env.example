LAB_TIMEZONE=America/Los_Angeles
LAB_DATABASE=data/labassist.sqlite3
# One structured routing call for EVERY submitted chat turn.
LAB_PLANNER=openai
LAB_MODEL=gpt-4.1-mini
OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
# Optional alternative: LAB_PLANNER=groq and LAB_MODEL=llama-3.3-70b-versatile
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=
LAB_ROUTER_MIN_CONFIDENCE=0.7
# Staff credentials are set locally with: python -m scripts.setup_staff
# Login is mandatory. Sessions expire after this many seconds (fixed lifetime).
LAB_SESSION_SECONDS=1800
# Start the existing LabRAG API first. No model/Pinecone keys are needed here.
LABRAG_BASE_URL=http://127.0.0.1:8000
LABRAG_TIMEOUT_SECONDS=90

# ElevenLabs SDK (optional; no speech requests are made automatically)
ELEVENLABS_API_KEY=

# Phase 1: synthetic-only general lab voice demo. Set a voice ID from your ElevenLabs account.
ELEVENLABS_VOICE_ID=
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

ELEVENLABS_AGENT_ID=

LABASSIST_WEBHOOK_SECRET=
# Live appointment tools reuse LAB_DATABASE; run python -m scripts.setup_voice_demo once.
